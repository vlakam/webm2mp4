{
  "name": "webm2mp4",
  "version": "2.0.0",
  "description": " Telegram bot that converts webm files to mp4 for users with Apple devices",
  "main": "dist/index.js",
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlakam/webm2mp4.git"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "tsc-alias",
    "start": "node ./dist/index.js",
    "dev": "ts-node -r tsconfig-paths/register ./src/index.ts"
  },
  "author": "vlakam",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/vlakam/webm2mp4/issues"
  },
  "homepage": "https://github.com/vlakam/webm2mp4#readme",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "dotenv": "^8.2.0",
    "i18next": "^25.7.1",
    "node-fetch": "^2.1.2",
    "p-queue": "^9.0.1",
    "telegraf": "^3.32.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/node-fetch": "^2.6.11",
    "eslint": "^8.57.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
